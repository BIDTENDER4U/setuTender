# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/setu?schema=public"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# --- AI (Anthropic) ---
# Used by src/lib/ai.ts to run the tender analysis engine.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- File storage ---
# "local" writes to ./uploads (fine for a single server / demo).
# "s3" uses the S3-compatible client in src/lib/storage.ts — set the vars below too.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# --- OCR (for scanned tender PDFs) ---
# Plug in a provider (e.g. Google Vision, AWS Textract, Azure Document Intelligence).
# src/lib/ocr.ts is a stub — implement runOcr() with your provider's SDK/API.
OCR_PROVIDER="none"
OCR_API_KEY=""

# --- Virus / malware scanning on upload ---
# src/lib/scan.ts is a stub — wire to ClamAV, VirusTotal, or a cloud scanning API.
SCAN_PROVIDER="none"
SCAN_API_KEY=""

# --- Payments (Razorpay) ---
# src/lib/payments.ts defines the interface; implement createOrder/verifyPayment
# with the Razorpay Node SDK once you have live/test keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Email (password reset, notifications) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Setu <no-reply@yourdomain.com>"
